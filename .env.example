# ── Supabase (free tier) ─────────────────────────────────────────────
# Project Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Public "anon" key. Only used for the Realtime "something changed" ping channel.
# All tables are locked by RLS, so this key cannot read or write any game data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SECRET service_role key. Server only. NEVER prefix with NEXT_PUBLIC_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Teacher protection (recommended) ─────────────────────────────────
# If set, creating a room requires this passcode, so students cannot create rooms
# or open the teacher dashboard for new rooms.
TEACHER_PASSCODE=choose-a-passcode

# ── Local development only ───────────────────────────────────────────
# Without Supabase keys the app uses an in-memory store (single Node process only).
# This is refused in production unless explicitly allowed. Never use it on Vercel.
# ALLOW_MEMORY_STORE=1
